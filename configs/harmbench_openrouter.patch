+class OpenRouter(GPT):
+    """Any model hosted on OpenRouter, via its OpenAI-compatible endpoint.
+
+    Use `model_name_or_path: openrouter/<openrouter model id>` in models.yaml. The API key is read
+    from the OPENROUTER_API_KEY environment variable (set in ~/.bashrc), never from the config.
+    """
+    API_BASE = "https://openrouter.ai/api/v1"
+    API_TIMEOUT = 300
+
+    def __init__(self, model_name, provider=None, system_prompt=None):
+        # provider: OpenRouter routing prefs, e.g. {order: [deepinfra], allow_fallbacks: false, quantizations: [bf16]}
+        #   (pins the serving provider/precision so differences can't come from a different provider's weights).
+        # system_prompt: sent explicitly so the API side gets the same system message as the local chat template.
+        api_key = os.environ.get("OPENROUTER_API_KEY")
+        if not api_key:
+            raise RuntimeError("OPENROUTER_API_KEY is not set (try: source ~/.bashrc)")
+        self.model_name = model_name
+        self.provider = provider
+        self.system_prompt = system_prompt
+        self.providers_seen = {}   # provider name -> count, from each response
+        self.client = OpenAI(api_key=api_key, base_url=self.API_BASE, timeout=self.API_TIMEOUT,
+                             default_headers={"X-Title": "HarmBench (openrouter)"})
+
+    def _generate(self, prompt, max_new_tokens, temperature, top_p):
+        messages = [{"role": "user", "content": prompt}]
+        if self.system_prompt:
+            messages.insert(0, {"role": "system", "content": self.system_prompt})
+        extra_body = {"provider": self.provider} if self.provider else None
+        for _ in range(self.API_MAX_RETRY):
+            try:
+                response = self.client.chat.completions.create(
+                    model=self.model_name, messages=messages, max_tokens=max_new_tokens,
+                    temperature=temperature, top_p=top_p, extra_body=extra_body)
+                name = getattr(response, "provider", None) or "unknown"
+                self.providers_seen[name] = self.providers_seen.get(name, 0) + 1
+                content = response.choices[0].message.content
+                return content if content is not None else self.API_ERROR_OUTPUT  # some providers return None
+            except openai.APIStatusError as e:
+                # Permanent errors (404 model gone, 400 bad request, 401/403 auth, 402 credits): retrying only
+                # burns ~50 s per case and silently yields $ERROR$. Abort the whole run instead.
+                if 400 <= e.status_code < 500 and e.status_code not in (408, 409, 429):
+                    raise RuntimeError(f"OpenRouter permanent error {e.status_code}: {e}") from e
+                print(type(e), e)
+            except openai.OpenAIError as e:   # timeouts / connection errors: transient
+                print(type(e), e)
+            time.sleep(self.API_RETRY_SLEEP)
+        return self.API_ERROR_OUTPUT
+
+    def generate(self, *args, **kwargs):
+        out = super().generate(*args, **kwargs)
+        print(f"OpenRouter providers used: {self.providers_seen}")
+        return out
+
+
 class GPTV():
     API_RETRY_SLEEP = 10
     API_ERROR_OUTPUT = "$ERROR$"
